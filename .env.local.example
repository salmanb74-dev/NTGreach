# ─── Supabase ────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Mailjet ─────────────────────────────────────────────────────────
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
MAILJET_FROM_EMAIL=umair@ntgclarity.com
MAILJET_FROM_NAME=Umair Khan — NTG Reach
INBOUND_DOMAIN=mail.ntgclarity.com

# ─── Webhook security ────────────────────────────────────────────────
# Generate any random string, e.g: openssl rand -hex 16
WEBHOOK_SECRET=your-random-secret-here

# ─── Support API (Resto Nest BFF) ─────────────────────────────────────
# Shared secret — Resto stores the same value as REACH_API_KEY (server-only).
# SUPPORT_API_KEY=openssl rand -hex 32
# Dedicated Supabase Auth user UUID used as created_by / customer sender_id.
# Create in Dashboard → Authentication → Users, then paste the user id here.
# SUPPORT_API_ACTOR_USER_ID=
# Reach-only secret used to sign 10-minute conversation-scoped Realtime JWTs.
# Supabase Dashboard → Project Settings → API → JWT Settings → Legacy JWT secret.
# Never expose this value to Resto, Nest, or either browser app.
# SUPABASE_JWT_SECRET=

# ─── Resto Ops portal (Reach → Nest) ─────────────────────────────────
# Server-only. Used by /ops to list tenants. Never expose as NEXT_PUBLIC_*.
# Staging
# RESTO_STAGING_BASE_URL=https://resto-staging.example.com
# RESTO_STAGING_ADMIN_API_KEY=
# Production
# RESTO_PROD_BASE_URL=https://resto.example.com
# RESTO_PROD_ADMIN_API_KEY=

# ─── Added in Phase 5: Microsoft Graph ──────────────────────────────
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
EXCHANGE_RATE_API_KEY=
